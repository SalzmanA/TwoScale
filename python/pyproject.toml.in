[build-system]
requires = [
    "scikit-build-core[pyproject]",
    "nanobind",
]
build-backend = "scikit_build_core.build"



[project]
name = "twoscale"
version = "@PROJECT_VERSION@"
description = "An implementation of the distributed two scale method"
authors = [
    { name = "Alexis Salzman", email = "alexis.salzman@ec-nantes.fr" },
]
readme = "README.md"
dependencies = [
    "fenics-dolfinx>=@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@,<@PROJECT_VERSION_MAJOR@.@DOLFINX_NEXT_MINOR@",
]

[tool.scikit-build]
cmake.build-type = "Release"
wheel.packages = ["twoscale"]
